# LinguaFlow Backend Configuration

# Application
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://linguaflow:password@localhost:5432/linguaflow

# GigaChat API (Сбер)
# Получите токен на https://developers.sber.ru/studio/workspaces
GIGACHAT_AUTH_TOKEN=your-gigachat-auth-token
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL=true

# TTS (Silero)
TTS_MODEL_DIR=./tts_models
TTS_AUDIO_DIR=./audio_cache
TTS_SAMPLE_RATE=48000

# CORS (frontend origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
